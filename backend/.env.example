PORT=3001
CORS_ORIGIN=http://localhost:5173

# Real walking data along the street network. Options: none | mapbox | ors
#   none   -> straight-line circles, no walk time (default)
#   mapbox -> Matrix + Isochrone APIs. Needs MAPBOX_TOKEN
#             https://account.mapbox.com/access-tokens/
#             Free tier: 100k requests/month. One search = 2 isochrone
#             calls + 1..2 matrix calls (cached by point and budget).
#   ors    -> Matrix + Isochrones APIs. Needs ORS_API_KEY
#             https://openrouteservice.org/dev/#/signup
#             Free tier: 500 isochrone requests/day. Fine for testing only.
WALK_PROVIDER=none
MAPBOX_TOKEN=
ORS_API_KEY=
